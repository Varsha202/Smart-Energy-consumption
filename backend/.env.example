# Smart Campus Energy Backend Environment Configuration

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_energy_db
ENERGY_COLLECTION=energy_records

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Emission and Tariff factors (Indian Grid & Commercial Educational Tariff)
GRID_EMISSION_FACTOR_KG_CO2_PER_KWH=0.72
DEFAULT_TARIFF_INR_PER_KWH=8.50
